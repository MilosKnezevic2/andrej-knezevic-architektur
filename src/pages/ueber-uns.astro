---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
	title="Über uns"
	description="Lernen Sie Dipl.-Ing. Andrej Knezevic kennen — Bauingenieur mit Leidenschaft für präzise Planung und sichere Konstruktionen."
>
	<Header slot="header" currentPath="/ueber-uns" />

	<!-- ═══════════════════ PAGE HERO — PERSONAL, SPLIT ═══════════════════ -->
	<section class="page-hero">
		<div class="page-hero__inner container--wide">
			<div class="page-hero__content reveal">
				<span class="page-hero__eyebrow">
					<span class="page-hero__eyebrow-line" aria-hidden="true"></span>
					Über uns
				</span>
				<h1 class="page-hero__title">
					Der Mensch hinter<br />
					<span class="page-hero__accent">der Berechnung.</span>
				</h1>
				<p class="page-hero__subtitle">
					Kein großer Konzern. Kein anonymes Büro. Sondern ein Ingenieur,
					der für jedes Projekt persönlich einsteht.
				</p>
				<div class="page-hero__signature">
					<span class="page-hero__sig-name">Dipl.-Ing. Andrej Knezevic</span>
					<span class="page-hero__sig-role">Gründer & Geschäftsführer</span>
				</div>
			</div>
			<div class="page-hero__portrait reveal">
				<img
					src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=700&h=900&fit=crop&crop=face"
					alt="Dipl.-Ing. Andrej Knezevic"
					width="700"
					height="900"
					loading="eager"
					fetchpriority="high"
					class="page-hero__portrait-image"
				/>
				<div class="page-hero__portrait-frame" aria-hidden="true"></div>
			</div>
		</div>
		<!-- Blueprint grid background -->
		<div class="page-hero__grid" aria-hidden="true"></div>
	</section>

	<!-- ═══════════════════ BIO — EDITORIAL TWO-COLUMN ═══════════════════ -->
	<section class="bio section">
		<div class="container">
			<div class="bio__grid">
				<!-- Left: intro + quote -->
				<div class="bio__left reveal">
					<p class="bio__lead">
						Mit 28 Jahren bringe ich nicht nur fundiertes Fachwissen mit,
						sondern auch eine frische Perspektive auf die Baubranche.
					</p>
					<blockquote class="bio__quote">
						<p>Gute Ingenieurarbeit muss nicht nur sicher und wirtschaftlich sein
						— sie darf auch Spaß machen.</p>
					</blockquote>
					<!-- Credentials cards -->
					<div class="bio__credentials">
						<div class="bio__credential">
							<div class="bio__credential-icon" aria-hidden="true">
								<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
							</div>
							<div>
								<span class="bio__credential-label">Ausbildung</span>
								<span class="bio__credential-value">Dipl.-Ing. Bauingenieurwesen, TU Graz</span>
							</div>
						</div>
						<div class="bio__credential">
							<div class="bio__credential-icon" aria-hidden="true">
								<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 20h20"/><path d="M5 20V8l7-5 7 5v12"/><path d="M9 20v-4h6v4"/></svg>
							</div>
							<div>
								<span class="bio__credential-label">Schwerpunkt</span>
								<span class="bio__credential-value">Tragwerksplanung, Stahlbeton- und Stahlbau</span>
							</div>
						</div>
						<div class="bio__credential">
							<div class="bio__credential-icon" aria-hidden="true">
								<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><path d="m9 15 2 2 4-4"/></svg>
							</div>
							<div>
								<span class="bio__credential-label">Zertifizierungen</span>
								<span class="bio__credential-value">Ziviltechniker-Befugnis, Energieausweis-Ersteller</span>
							</div>
						</div>
					</div>
				</div>

				<!-- Right: body text + image -->
				<div class="bio__right reveal">
					<p class="bio__text">
						Nach meinem Studium des Bauingenieurwesens an der Technischen Universität Graz
						habe ich in führenden Ingenieurbüros in Österreich Erfahrung gesammelt — von der
						Tragwerksplanung für Wohnanlagen bis zur Bauleitung komplexer Gewerbeprojekte.
					</p>
					<p class="bio__text">
						Ich arbeite nicht mit starren Hierarchien, sondern direkt — schnell, persönlich,
						verbindlich. Bei mir haben Sie einen Ansprechpartner, der Ihr Projekt von Anfang
						bis Ende kennt.
					</p>
					<p class="bio__text">
						Mein Anspruch: Jedes Projekt, das mein Büro verlässt, ist technisch einwandfrei,
						termingerecht und wirtschaftlich optimiert. Ohne Kompromisse.
					</p>
					<div class="bio__image-wrapper">
						<img
							src="https://images.unsplash.com/photo-1581094794329-c8112a89af12?w=700&h=450&fit=crop"
							alt="Technische Zeichnungen und Baupläne — Arbeitsalltag im Büro"
							width="700"
							height="450"
							loading="lazy"
							decoding="async"
							class="bio__image"
						/>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- ═══════════════════ TIMELINE ═══════════════════ -->
	<section class="timeline">
		<div class="container">
			<div class="timeline__header reveal">
				<span class="timeline__eyebrow">Werdegang</span>
				<h2 class="timeline__title">Von der Universität<br />zum eigenen Büro</h2>
			</div>
			<div class="timeline__items">
				<div class="timeline__item reveal">
					<span class="timeline__year">2016</span>
					<div class="timeline__content">
						<h3 class="timeline__item-title">Studienbeginn</h3>
						<p class="timeline__item-text">Beginn des Studiums Bauingenieurwesen an der Technischen Universität Graz mit Schwerpunkt Tragwerkslehre und Konstruktion.</p>
					</div>
				</div>
				<div class="timeline__item reveal">
					<span class="timeline__year">2019</span>
					<div class="timeline__content">
						<h3 class="timeline__item-title">Erste Praxiserfahrung</h3>
						<p class="timeline__item-text">Praktikum und anschließende Teilzeitbeschäftigung bei einem renommierten Ingenieurbüro in Graz. Erste eigenständige Tragwerksberechnungen.</p>
					</div>
				</div>
				<div class="timeline__item reveal">
					<span class="timeline__year">2021</span>
					<div class="timeline__content">
						<h3 class="timeline__item-title">Diplomabschluss</h3>
						<p class="timeline__item-text">Erfolgreicher Abschluss als Dipl.-Ing. mit Auszeichnung. Diplomarbeit im Bereich Erdbebensicherheit bestehender Stahlbetonbauten.</p>
					</div>
				</div>
				<div class="timeline__item reveal">
					<span class="timeline__year">2022</span>
					<div class="timeline__content">
						<h3 class="timeline__item-title">Projektleiter Tragwerksplanung</h3>
						<p class="timeline__item-text">Übernahme der Projektleitung für Wohn- und Gewerbebauprojekte. Verantwortung für Statik, Einreichung und Baubegleitung.</p>
					</div>
				</div>
				<div class="timeline__item timeline__item--active reveal">
					<span class="timeline__year">2024</span>
					<div class="timeline__content">
						<h3 class="timeline__item-title">Gründung des eigenen Büros</h3>
						<p class="timeline__item-text">Eröffnung des Bauingenieurbüros in St. Stefan im Lavanttal. Seither über 47 Projekte in ganz Österreich erfolgreich realisiert.</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- ═══════════════════ PHILOSOPHY ═══════════════════ -->
	<section class="approach section">
		<div class="container">
			<div class="approach__inner reveal">
				<span class="approach__eyebrow">Arbeitsphilosophie</span>
				<h2 class="approach__title">Wie wir arbeiten</h2>
				<div class="approach__grid">
					<div class="approach__item">
						<h3 class="approach__item-title">Direkt, nicht bürokratisch</h3>
						<p class="approach__item-text">Ein Ansprechpartner, kurze Wege, schnelle Entscheidungen. Keine Abstimmungsschleifen, keine Warteschlangen.</p>
					</div>
					<div class="approach__item">
						<h3 class="approach__item-title">Genau, nicht überdimensioniert</h3>
						<p class="approach__item-text">Wirtschaftliche Lösungen statt übertriebener Sicherheitszuschläge. Jede Berechnung optimiert — nicht geschätzt.</p>
					</div>
					<div class="approach__item">
						<h3 class="approach__item-title">Verbindlich, nicht flexibel</h3>
						<p class="approach__item-text">Wenn wir einen Termin nennen, halten wir ihn. Wenn wir ein Budget kalkulieren, stimmt es. 100% Termintreue ist unser Standard.</p>
					</div>
					<div class="approach__item">
						<h3 class="approach__item-title">Modern, nicht altmodisch</h3>
						<p class="approach__item-text">Aktuelle Software, aktuelle Normen, aktuelle Methoden. Wir arbeiten mit BIM, 3D-Modellen und digitaler Planungskoordination.</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<Footer slot="footer" />
</Layout>

<style>
	/* ═══════════════════ PAGE HERO — SPLIT PERSONAL ═══════════════════ */
	.page-hero {
		position: relative;
		background: var(--color-navy);
		padding-top: 80px;
		overflow: hidden;
	}

	.page-hero__grid {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(rgba(var(--color-brass-rgb), 0.03) 1px, transparent 1px),
			linear-gradient(90deg, rgba(var(--color-brass-rgb), 0.03) 1px, transparent 1px);
		background-size: 60px 60px;
		pointer-events: none;
	}

	.page-hero__inner {
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-10);
		padding: var(--space-16) var(--section-x) 0;
		max-width: var(--container-wide);
		margin-inline: auto;
	}

	@media (min-width: 1024px) {
		.page-hero__inner {
			grid-template-columns: 1fr 1fr;
			align-items: end;
			gap: var(--space-16);
			padding-top: var(--space-20);
		}
	}

	.page-hero__content {
		display: flex;
		flex-direction: column;
		gap: var(--space-5);
		padding-bottom: var(--space-12);
	}

	@media (min-width: 1024px) {
		.page-hero__content {
			padding-bottom: var(--space-20);
		}
	}

	.page-hero__eyebrow {
		display: flex;
		align-items: center;
		gap: var(--space-4);
		font-family: var(--font-body);
		font-size: var(--text-xs);
		font-weight: 600;
		letter-spacing: 0.3em;
		text-transform: uppercase;
		color: var(--color-brass);
	}

	.page-hero__eyebrow-line {
		width: 40px;
		height: 1px;
		background: var(--color-brass);
	}

	.page-hero__title {
		font-family: var(--font-heading);
		font-size: clamp(2.2rem, 1.8rem + 3vw, 4rem);
		font-weight: 700;
		line-height: 1.08;
		color: var(--color-white);
		letter-spacing: -0.01em;
	}

	.page-hero__accent {
		color: var(--color-brass-light);
		font-style: italic;
	}

	.page-hero__subtitle {
		font-size: var(--text-lg);
		line-height: 1.7;
		color: rgba(255, 255, 255, 0.55);
		max-width: 440px;
	}

	.page-hero__signature {
		margin-top: var(--space-4);
		padding-top: var(--space-4);
		border-top: 1px solid rgba(255, 255, 255, 0.1);
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
	}

	.page-hero__sig-name {
		font-family: var(--font-heading);
		font-size: var(--text-base);
		font-weight: 600;
		color: var(--color-white);
	}

	.page-hero__sig-role {
		font-size: var(--text-sm);
		color: rgba(255, 255, 255, 0.4);
	}

	/* Portrait */
	.page-hero__portrait {
		position: relative;
		justify-self: center;
	}

	@media (min-width: 1024px) {
		.page-hero__portrait {
			justify-self: end;
		}
	}

	.page-hero__portrait-image {
		width: 100%;
		max-width: 420px;
		height: auto;
		aspect-ratio: 3 / 4;
		object-fit: cover;
		object-position: center top;
		border-radius: var(--radius-md) var(--radius-md) 0 0;
		display: block;
	}

	.page-hero__portrait-frame {
		position: absolute;
		top: -12px;
		right: -12px;
		width: 100%;
		max-width: 420px;
		height: calc(100% - 20px);
		border: 2px solid rgba(var(--color-brass-rgb), 0.2);
		border-radius: var(--radius-md);
		pointer-events: none;
	}

	@media (max-width: 1023px) {
		.page-hero__portrait-frame {
			display: none;
		}
	}

	/* ═══════════════════ BIO ═══════════════════ */
	/* ═══════════════════ BIO — EDITORIAL ═══════════════════ */
	.bio {
		background: var(--color-white);
	}

	.bio__grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-12);
	}

	@media (min-width: 1024px) {
		.bio__grid {
			grid-template-columns: 1fr 1fr;
			gap: var(--space-16);
		}
	}

	.bio__lead {
		font-family: var(--font-heading);
		font-size: var(--text-2xl);
		font-weight: 600;
		line-height: 1.4;
		color: var(--color-navy);
		margin-bottom: var(--space-8);
	}

	.bio__quote {
		border-left: 3px solid var(--color-brass);
		padding-left: var(--space-6);
		margin-bottom: var(--space-10);
	}

	.bio__quote p {
		font-family: var(--font-heading);
		font-size: var(--text-lg);
		font-style: italic;
		font-weight: 500;
		line-height: 1.6;
		color: var(--color-navy);
		opacity: 0.8;
	}

	/* Credential cards */
	.bio__credentials {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
	}

	.bio__credential {
		display: flex;
		align-items: flex-start;
		gap: var(--space-4);
		padding: var(--space-4) var(--space-5);
		background: var(--color-warm-white);
		border-radius: var(--radius-md);
		border: 1px solid var(--color-border);
	}

	.bio__credential-icon {
		flex-shrink: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 40px;
		height: 40px;
		border-radius: var(--radius-sm);
		background: rgba(var(--color-brass-rgb), 0.1);
		color: var(--color-brass);
		margin-top: 2px;
	}

	.bio__credential-label {
		display: block;
		font-size: var(--text-xs);
		font-weight: 600;
		color: var(--color-brass);
		letter-spacing: 0.1em;
		text-transform: uppercase;
		margin-bottom: var(--space-1);
	}

	.bio__credential-value {
		display: block;
		font-size: var(--text-base);
		color: var(--color-charcoal);
		font-weight: 500;
	}

	/* Right column */
	.bio__text {
		font-size: var(--text-base);
		line-height: 1.8;
		color: var(--color-muted);
		margin-bottom: var(--space-5);
	}

	.bio__image-wrapper {
		margin-top: var(--space-6);
		border-radius: var(--radius-md);
		overflow: hidden;
	}

	.bio__image {
		width: 100%;
		height: auto;
		aspect-ratio: 7 / 4.5;
		object-fit: cover;
	}

	/* ═══════════════════ TIMELINE ═══════════════════ */
	.timeline {
		background: var(--color-navy);
		padding-block: var(--section-y);
	}

	.timeline__header {
		margin-bottom: var(--space-12);
	}

	.timeline__eyebrow {
		display: block;
		font-family: var(--font-body);
		font-size: var(--text-xs);
		font-weight: 600;
		letter-spacing: 0.25em;
		text-transform: uppercase;
		color: var(--color-brass);
		margin-bottom: var(--space-3);
	}

	.timeline__title {
		font-family: var(--font-heading);
		font-size: var(--text-4xl);
		font-weight: 700;
		color: var(--color-white);
		line-height: 1.1;
	}

	.timeline__items {
		display: flex;
		flex-direction: column;
		gap: 0;
	}

	.timeline__item {
		display: grid;
		grid-template-columns: 80px 1fr;
		gap: var(--space-6);
		padding-block: var(--space-6);
		border-top: 1px solid rgba(255, 255, 255, 0.1);
	}

	@media (min-width: 768px) {
		.timeline__item {
			grid-template-columns: 120px 1fr;
			gap: var(--space-10);
			padding-block: var(--space-8);
		}
	}

	.timeline__year {
		font-family: var(--font-heading);
		font-size: var(--text-2xl);
		font-weight: 700;
		color: rgba(255, 255, 255, 0.2);
		line-height: 1;
		padding-top: var(--space-1);
	}

	.timeline__item--active .timeline__year {
		color: var(--color-brass);
	}

	.timeline__item-title {
		font-family: var(--font-heading);
		font-size: var(--text-lg);
		font-weight: 600;
		color: var(--color-white);
		margin-bottom: var(--space-2);
	}

	.timeline__item-text {
		font-size: var(--text-base);
		color: rgba(255, 255, 255, 0.5);
		line-height: 1.7;
		max-width: 560px;
	}

	/* ═══════════════════ APPROACH ═══════════════════ */
	.approach {
		background: var(--color-warm-white);
	}

	.approach__eyebrow {
		display: block;
		font-family: var(--font-body);
		font-size: var(--text-xs);
		font-weight: 600;
		letter-spacing: 0.25em;
		text-transform: uppercase;
		color: var(--color-brass);
		margin-bottom: var(--space-3);
	}

	.approach__title {
		font-family: var(--font-heading);
		font-size: var(--text-3xl);
		font-weight: 700;
		color: var(--color-navy);
		margin-bottom: var(--space-10);
	}

	.approach__grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-8);
	}

	@media (min-width: 768px) {
		.approach__grid {
			grid-template-columns: 1fr 1fr;
			gap: var(--space-10);
		}
	}

	.approach__item {
		padding-left: var(--space-6);
		border-left: 2px solid var(--color-brass);
	}

	.approach__item-title {
		font-family: var(--font-heading);
		font-size: var(--text-lg);
		font-weight: 600;
		color: var(--color-navy);
		margin-bottom: var(--space-2);
	}

	.approach__item-text {
		font-size: var(--text-base);
		color: var(--color-muted);
		line-height: 1.7;
	}
</style>
