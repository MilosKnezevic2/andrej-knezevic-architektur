---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
	title="Seite nicht gefunden"
	description="Die angeforderte Seite wurde nicht gefunden."
	noindex={true}
>
	<Header slot="header" />

	<section class="not-found">
		<div class="not-found__inner container">
			<span class="not-found__code" aria-hidden="true">404</span>
			<h1 class="not-found__title">Seite nicht gefunden</h1>
			<p class="not-found__text">
				Die Seite, die Sie suchen, existiert nicht oder wurde verschoben.
			</p>
			<div class="not-found__actions">
				<a href="/" class="btn btn--primary">Zur Startseite</a>
				<a href="/kontakt" class="btn btn--secondary">Kontakt aufnehmen</a>
			</div>
		</div>
	</section>

	<Footer slot="footer" />
</Layout>

<style>
	.btn { display: inline-flex; align-items: center; justify-content: center; gap: var(--space-2); font-family: var(--font-body); font-weight: 600; font-size: var(--text-sm); letter-spacing: 0.02em; padding: var(--space-3) var(--space-8); border-radius: var(--radius-sm); transition: background var(--transition-fast), color var(--transition-fast), transform var(--transition-fast), box-shadow var(--transition-fast); cursor: pointer; text-decoration: none; border: 1.5px solid transparent; touch-action: manipulation; }
	.btn:active { transform: scale(0.97); }
	.btn--primary { background: var(--color-brass); color: var(--color-navy); border-color: var(--color-brass); }
	.btn--primary:hover { background: var(--color-brass-dark); border-color: var(--color-brass-dark); box-shadow: 0 4px 24px rgba(var(--color-brass-rgb), 0.35); transform: translateY(-2px); }
	.btn--secondary { background: transparent; color: var(--color-navy); border-color: var(--color-navy); }
	.btn--secondary:hover { background: var(--color-navy); color: var(--color-white); transform: translateY(-2px); }

	.not-found {
		padding-top: 80px;
		min-height: 80vh;
		min-height: 80dvh;
		display: flex;
		align-items: center;
		justify-content: center;
		background: var(--color-warm-white);
	}

	.not-found__inner {
		text-align: center;
		max-width: 500px;
	}

	.not-found__code {
		display: block;
		font-family: var(--font-heading);
		font-size: clamp(6rem, 5rem + 8vw, 12rem);
		font-weight: 700;
		line-height: 1;
		color: var(--color-navy);
		opacity: 0.06;
		margin-bottom: var(--space-4);
	}

	.not-found__title {
		font-family: var(--font-heading);
		font-size: var(--text-3xl);
		font-weight: 700;
		color: var(--color-navy);
		margin-bottom: var(--space-4);
		margin-top: calc(var(--space-8) * -1);
	}

	.not-found__text {
		font-size: var(--text-lg);
		color: var(--color-muted);
		line-height: 1.6;
		margin-bottom: var(--space-8);
	}

	.not-found__actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: var(--space-4);
	}
</style>
