---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
	title="Home"
	description="Bauingenieurbüro Andrej Knezevic — Tragwerksplanung, Bauleitung und Projektsteuerung aus einer Hand. Präzise Planung für Ihren Bauerfolg."
>
	<Header slot="header" currentPath="/" />

	<!-- ═══════════════════ HERO — FULL VIEWPORT, CINEMATIC ═══════════════════ -->
	<section class="hero">
		<!-- Background image with overlay -->
		<div class="hero__bg">
			<img
				src="https://images.unsplash.com/photo-1541888946425-d81bb19240f5?w=1920&h=1080&fit=crop&crop=center&q=80"
				alt=""
				role="presentation"
				width="1920"
				height="1080"
				loading="eager"
				fetchpriority="high"
				class="hero__bg-image"
			/>
			<div class="hero__bg-overlay" aria-hidden="true"></div>
			<!-- Blueprint grid -->
			<div class="hero__grid" aria-hidden="true"></div>
		</div>

		<div class="hero__content">
			<div class="hero__content-inner">
				<span class="hero__eyebrow reveal">
					<span class="hero__eyebrow-line" aria-hidden="true"></span>
					Bauingenieurbüro
				</span>
				<h1 class="hero__title reveal">
					Wir bauen nicht.<br />
					<span class="hero__title-accent">Wir denken vor.</span>
				</h1>
				<p class="hero__subtitle reveal">
					Tragwerksplanung, Bauleitung und Projektsteuerung —
					mit der Präzision, die Ihr Bauvorhaben verdient.
				</p>
				<div class="hero__actions reveal">
					<a href="/kontakt" class="btn btn--primary btn--lg">
						Projekt besprechen
						<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
					</a>
					<a href="/projekte" class="btn btn--ghost">Referenzen ansehen</a>
				</div>
			</div>

			<!-- Side stats — vertical on desktop -->
			<div class="hero__stats reveal" aria-label="Kennzahlen">
				<div class="hero__stat">
					<span class="hero__stat-number">47+</span>
					<span class="hero__stat-label">Projekte</span>
				</div>
				<div class="hero__stat-divider" aria-hidden="true"></div>
				<div class="hero__stat">
					<span class="hero__stat-number">100%</span>
					<span class="hero__stat-label">Termingerecht</span>
				</div>
				<div class="hero__stat-divider" aria-hidden="true"></div>
				<div class="hero__stat">
					<span class="hero__stat-number">8</span>
					<span class="hero__stat-label">Bundesländer</span>
				</div>
			</div>
		</div>

		<!-- Scroll indicator -->
		<div class="hero__scroll" aria-hidden="true">
			<span class="hero__scroll-text">Scroll</span>
			<div class="hero__scroll-line"></div>
		</div>
	</section>

	<!-- ═══════════════════ PHILOSOPHY — BOLD STATEMENT ═══════════════════ -->
	<section class="philosophy section">
		<div class="container">
			<div class="philosophy__inner reveal">
				<span class="philosophy__eyebrow">Unsere Philosophie</span>
				<blockquote class="philosophy__quote">
					Jedes Bauwerk beginnt mit einer Idee.
					<span class="philosophy__highlight">Unsere Aufgabe ist es,</span>
					diese Idee in eine sichere, wirtschaftliche und nachhaltige Realität zu verwandeln.
				</blockquote>
				<div class="philosophy__line" aria-hidden="true"></div>
				<p class="philosophy__author">Dipl.-Ing. Andrej Knezevic</p>
			</div>
		</div>
	</section>

	<!-- ═══════════════════ SERVICES — EDITORIAL LAYOUT ═══════════════════ -->
	<section class="services section">
		<div class="container">
			<div class="services__header reveal">
				<span class="services__eyebrow">Leistungen</span>
				<h2 class="services__title">Was wir für<br />Sie leisten</h2>
			</div>

			<div class="services__list">
				<a href="/leistungen#tragwerksplanung" class="service-row reveal">
					<span class="service-row__number">01</span>
					<div class="service-row__content">
						<h3 class="service-row__title">Tragwerksplanung</h3>
						<p class="service-row__text">Statische Berechnungen und Konstruktionsplanung für sichere, wirtschaftliche Tragwerke — vom Einfamilienhaus bis zum Industriebau.</p>
					</div>
					<div class="service-row__arrow" aria-hidden="true">
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7"/><path d="M7 7h10v10"/></svg>
					</div>
				</a>
				<a href="/leistungen#einreichplanung" class="service-row reveal">
					<span class="service-row__number">02</span>
					<div class="service-row__content">
						<h3 class="service-row__title">Einreichplanung</h3>
						<p class="service-row__text">Behördenkonforme Planunterlagen für eine reibungslose Baugenehmigung. Wir kennen die Vorschriften — Sie sparen Zeit.</p>
					</div>
					<div class="service-row__arrow" aria-hidden="true">
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7"/><path d="M7 7h10v10"/></svg>
					</div>
				</a>
				<a href="/leistungen#ausfuehrungsplanung" class="service-row reveal">
					<span class="service-row__number">03</span>
					<div class="service-row__content">
						<h3 class="service-row__title">Ausführungsplanung</h3>
						<p class="service-row__text">Detaillierte Werkpläne und Ausführungsdetails, die keine Fragen offenlassen. Präzision, die man auf der Baustelle spürt.</p>
					</div>
					<div class="service-row__arrow" aria-hidden="true">
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7"/><path d="M7 7h10v10"/></svg>
					</div>
				</a>
				<a href="/leistungen#bauleitung" class="service-row reveal">
					<span class="service-row__number">04</span>
					<div class="service-row__content">
						<h3 class="service-row__title">Bauleitung & Bauaufsicht</h3>
						<p class="service-row__text">Professionelle Bauüberwachung vor Ort. Qualität, Termine und Kosten — alles unter Kontrolle.</p>
					</div>
					<div class="service-row__arrow" aria-hidden="true">
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7"/><path d="M7 7h10v10"/></svg>
					</div>
				</a>
				<a href="/leistungen#energieausweis" class="service-row reveal">
					<span class="service-row__number">05</span>
					<div class="service-row__content">
						<h3 class="service-row__title">Energieausweis</h3>
						<p class="service-row__text">Normgerechte Energieausweise für Neubau und Bestand. Pflicht erfüllt — Potenziale erkannt.</p>
					</div>
					<div class="service-row__arrow" aria-hidden="true">
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7"/><path d="M7 7h10v10"/></svg>
					</div>
				</a>
				<a href="/leistungen#sanierung" class="service-row reveal">
					<span class="service-row__number">06</span>
					<div class="service-row__content">
						<h3 class="service-row__title">Sanierung & Umbau</h3>
						<p class="service-row__text">Vom Altbau bis zur Industrieanlage. Bestandsaufnahme, Planung und Begleitung — für ein neues Leben alter Substanz.</p>
					</div>
					<div class="service-row__arrow" aria-hidden="true">
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7"/><path d="M7 7h10v10"/></svg>
					</div>
				</a>
			</div>
		</div>
	</section>

	<!-- ═══════════════════ FEATURED PROJECTS — ASYMMETRIC GRID ═══════════════════ -->
	<section class="projects section">
		<div class="container">
			<div class="projects__header">
				<div class="projects__header-left reveal">
					<span class="projects__eyebrow">Referenzen</span>
					<h2 class="projects__title">Ausgewählte<br />Projekte</h2>
				</div>
				<div class="projects__header-right reveal">
					<p class="projects__subtitle">Ein Auszug unserer realisierten Projekte — jedes einzelne mit dem Anspruch an Präzision, Termintreue und technische Exzellenz.</p>
					<a href="/projekte" class="btn btn--secondary">Alle Projekte</a>
				</div>
			</div>

			<div class="projects__grid">
				<!-- Large featured project -->
				<a href="/projekte/wohnanlage-sonnenberg" class="project project--large reveal">
					<div class="project__image-wrapper">
						<img
							src="https://images.unsplash.com/photo-1545324418-cc1a3fa10c00?w=900&h=600&fit=crop"
							alt="Wohnanlage Sonnenberg — 24 Wohneinheiten in Klagenfurt"
							width="900"
							height="600"
							loading="lazy"
							decoding="async"
							class="project__image"
						/>
					</div>
					<div class="project__info">
						<span class="project__category">Neubau — Wohnbau</span>
						<h3 class="project__name">Wohnanlage Sonnenberg</h3>
						<p class="project__location">Klagenfurt am Wörthersee</p>
						<p class="project__detail">24 Wohneinheiten · 3.200 m² · Tragwerksplanung & Bauleitung</p>
					</div>
				</a>

				<!-- Two smaller projects -->
				<div class="projects__col">
					<a href="/projekte/buerogebaeude-techpark-villach" class="project reveal">
						<div class="project__image-wrapper">
							<img
								src="https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?w=600&h=500&fit=crop"
								alt="Bürogebäude TechPark Villach"
								width="600"
								height="500"
								loading="lazy"
								decoding="async"
								class="project__image"
							/>
						</div>
						<div class="project__info">
							<span class="project__category">Gewerbe</span>
							<h3 class="project__name">TechPark Bürogebäude</h3>
							<p class="project__location">Villach</p>
						</div>
					</a>
					<a href="/projekte/altbau-sanierung-graz" class="project reveal">
						<div class="project__image-wrapper">
							<img
								src="https://images.unsplash.com/photo-1560448204-e02f11c3d0e2?w=600&h=500&fit=crop"
								alt="Altbausanierung Gründerzeit in Graz"
								width="600"
								height="500"
								loading="lazy"
								decoding="async"
								class="project__image"
							/>
						</div>
						<div class="project__info">
							<span class="project__category">Sanierung</span>
							<h3 class="project__name">Altbau Gründerzeit</h3>
							<p class="project__location">Graz</p>
						</div>
					</a>
				</div>
			</div>
		</div>
	</section>

	<!-- ═══════════════════ PROCESS — HOW WE WORK ═══════════════════ -->
	<section class="process">
		<div class="process__inner container">
			<div class="process__header reveal">
				<span class="process__eyebrow">Arbeitsweise</span>
				<h2 class="process__title">Von der Idee<br />zur Fertigstellung</h2>
			</div>
			<div class="process__steps">
				<div class="process__step reveal">
					<div class="process__step-marker">
						<span class="process__step-number">01</span>
						<div class="process__step-line" aria-hidden="true"></div>
					</div>
					<div class="process__step-content">
						<h3 class="process__step-title">Erstgespräch</h3>
						<p class="process__step-text">Wir hören zu. Sie erzählen uns von Ihrem Vorhaben — wir stellen die richtigen Fragen und entwickeln ein erstes Verständnis.</p>
					</div>
				</div>
				<div class="process__step reveal">
					<div class="process__step-marker">
						<span class="process__step-number">02</span>
						<div class="process__step-line" aria-hidden="true"></div>
					</div>
					<div class="process__step-content">
						<h3 class="process__step-title">Konzept & Planung</h3>
						<p class="process__step-text">Statik, Konstruktion, Einreichung — wir erarbeiten die optimale Lösung. Technisch einwandfrei, wirtschaftlich sinnvoll.</p>
					</div>
				</div>
				<div class="process__step reveal">
					<div class="process__step-marker">
						<span class="process__step-number">03</span>
						<div class="process__step-line" aria-hidden="true"></div>
					</div>
					<div class="process__step-content">
						<h3 class="process__step-title">Umsetzung & Begleitung</h3>
						<p class="process__step-text">Auf der Baustelle sind wir Ihr Auge. Qualität, Termine, Kosten — alles wird überwacht, nichts dem Zufall überlassen.</p>
					</div>
				</div>
				<div class="process__step reveal">
					<div class="process__step-marker">
						<span class="process__step-number">04</span>
					</div>
					<div class="process__step-content">
						<h3 class="process__step-title">Übergabe</h3>
						<p class="process__step-text">Dokumentation, Abnahme, Fertigstellung. Ihr Projekt ist in besten Händen — bis zum letzten Detail.</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- ═══════════════════ CTA — DRAMATIC ═══════════════════ -->
	<section class="cta">
		<div class="cta__bg">
			<img
				src="https://images.unsplash.com/photo-1503387762-592deb58ef4e?w=1920&h=800&fit=crop&q=80"
				alt=""
				role="presentation"
				width="1920"
				height="800"
				loading="lazy"
				decoding="async"
				class="cta__bg-image"
			/>
			<div class="cta__bg-overlay" aria-hidden="true"></div>
		</div>
		<div class="cta__inner container reveal">
			<h2 class="cta__title">Bereit für Ihr<br />nächstes Projekt?</h2>
			<p class="cta__text">
				Erzählen Sie uns davon. Das Erstgespräch ist unverbindlich und kostenlos.
			</p>
			<div class="cta__actions">
				<a href="/kontakt" class="btn btn--primary btn--lg">
					Kontakt aufnehmen
					<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
				</a>
				<a href="tel:+436677712038" class="cta__phone">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
					+43 667 771 2038
				</a>
			</div>
		</div>
	</section>

	<Footer slot="footer" />
</Layout>

<style>
	/* ═══════════════════ BUTTONS ═══════════════════ */
	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: var(--space-2);
		font-family: var(--font-body);
		font-weight: 600;
		font-size: var(--text-sm);
		letter-spacing: 0.02em;
		padding: var(--space-3) var(--space-8);
		border-radius: var(--radius-sm);
		transition:
			background var(--transition-fast),
			color var(--transition-fast),
			transform var(--transition-fast),
			box-shadow var(--transition-fast),
			border-color var(--transition-fast);
		cursor: pointer;
		text-decoration: none;
		border: 1.5px solid transparent;
		touch-action: manipulation;
	}
	.btn:active { transform: scale(0.97); }

	.btn--primary {
		background: var(--color-brass);
		color: var(--color-navy);
		border-color: var(--color-brass);
	}
	.btn--primary:hover {
		background: var(--color-brass-dark);
		border-color: var(--color-brass-dark);
		box-shadow: 0 4px 24px rgba(var(--color-brass-rgb), 0.35);
		transform: translateY(-2px);
	}

	.btn--secondary {
		background: transparent;
		color: var(--color-navy);
		border-color: var(--color-navy);
	}
	.btn--secondary:hover {
		background: var(--color-navy);
		color: var(--color-white);
		transform: translateY(-2px);
	}

	.btn--ghost {
		background: transparent;
		color: var(--color-white);
		border-color: rgba(255, 255, 255, 0.3);
	}
	.btn--ghost:hover {
		border-color: var(--color-white);
		background: rgba(255, 255, 255, 0.08);
		transform: translateY(-2px);
	}

	.btn--lg {
		padding: var(--space-4) var(--space-10);
		font-size: var(--text-base);
	}

	/* ═══════════════════ HERO — CINEMATIC ═══════════════════ */
	.hero {
		position: relative;
		min-height: 100vh;
		min-height: 100dvh;
		display: flex;
		align-items: flex-end;
		padding-top: 80px;
		overflow: hidden;
	}

	.hero__bg {
		position: absolute;
		inset: 0;
		z-index: 0;
	}

	.hero__bg-image {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 30%;
		transform: scale(1.1);
		will-change: transform;
	}

	.hero__bg-overlay {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(180deg,
				rgba(12, 26, 46, 0.4) 0%,
				rgba(12, 26, 46, 0.6) 40%,
				rgba(12, 26, 46, 0.92) 100%
			);
	}

	.hero__grid {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(rgba(var(--color-brass-rgb), 0.04) 1px, transparent 1px),
			linear-gradient(90deg, rgba(var(--color-brass-rgb), 0.04) 1px, transparent 1px);
		background-size: 60px 60px;
	}

	.hero__content {
		position: relative;
		z-index: 1;
		width: 100%;
		max-width: var(--container-wide);
		margin-inline: auto;
		padding: 0 var(--section-x) var(--space-16);
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		gap: var(--space-12);
	}

	.hero__content-inner {
		max-width: 720px;
		display: flex;
		flex-direction: column;
		gap: var(--space-6);
	}

	.hero__eyebrow {
		display: flex;
		align-items: center;
		gap: var(--space-4);
		font-family: var(--font-body);
		font-size: var(--text-xs);
		font-weight: 600;
		letter-spacing: 0.3em;
		text-transform: uppercase;
		color: var(--color-brass);
	}

	.hero__eyebrow-line {
		width: 40px;
		height: 1px;
		background: var(--color-brass);
	}

	.hero__title {
		font-family: var(--font-heading);
		font-size: clamp(2.5rem, 2rem + 4vw, 5rem);
		font-weight: 700;
		line-height: 1.05;
		color: var(--color-white);
		letter-spacing: -0.02em;
	}

	.hero__title-accent {
		color: var(--color-brass-light);
		font-style: italic;
	}

	.hero__subtitle {
		font-size: var(--text-lg);
		line-height: 1.7;
		color: rgba(255, 255, 255, 0.6);
		max-width: 500px;
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-4);
		margin-top: var(--space-4);
	}

	/* Hero stats — side column on desktop */
	.hero__stats {
		display: none;
	}

	@media (min-width: 1024px) {
		.hero__stats {
			display: flex;
			flex-direction: column;
			align-items: flex-end;
			gap: var(--space-6);
			padding-bottom: var(--space-4);
		}
	}

	.hero__stat {
		text-align: right;
	}

	.hero__stat-number {
		display: block;
		font-family: var(--font-heading);
		font-size: var(--text-3xl);
		font-weight: 700;
		color: var(--color-white);
		line-height: 1;
	}

	.hero__stat-label {
		font-size: var(--text-xs);
		color: rgba(255, 255, 255, 0.4);
		font-weight: 500;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		margin-top: var(--space-1);
	}

	.hero__stat-divider {
		width: 30px;
		height: 1px;
		background: rgba(var(--color-brass-rgb), 0.3);
		align-self: flex-end;
	}

	/* Scroll indicator */
	.hero__scroll {
		position: absolute;
		bottom: var(--space-8);
		left: 50%;
		transform: translateX(-50%);
		display: flex;
