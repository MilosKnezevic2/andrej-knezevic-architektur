---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import projects from '../../content/projekte/data.json';

export function getStaticPaths() {
	return projects.map((project) => ({
		params: { slug: project.slug },
		props: { project },
	}));
}

const { project } = Astro.props;

// Find next/prev projects for navigation
const currentIndex = projects.findIndex((p) => p.slug === project.slug);
const nextProject = projects[(currentIndex + 1) % projects.length];
const prevProject = projects[(currentIndex - 1 + projects.length) % projects.length];
---

<Layout
	title={project.title}
	description={`${project.title} — ${project.subcategory} in ${project.location}. ${project.services.join(', ')}. Case Study des Bauingenieurbüros Andrej Knezevic.`}
>
	<Header slot="header" currentPath="/projekte" />

	<!-- ═══════════════════ PROJECT HERO ═══════════════════ -->
	<section class="project-hero">
		<div class="project-hero__bg">
			<img
				src={project.heroImage}
				alt={`${project.title} — ${project.subcategory} in ${project.location}`}
				width="1920"
				height="900"
				loading="eager"
				fetchpriority="high"
				class="project-hero__bg-image"
			/>
			<div class="project-hero__bg-overlay" aria-hidden="true"></div>
		</div>
		<div class="project-hero__inner container">
			<a href="/projekte" class="project-hero__back reveal">
				<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
				Alle Projekte
			</a>
			<div class="project-hero__content reveal">
				<span class="project-hero__category">{project.category} — {project.subcategory}</span>
				<h1 class="project-hero__title">{project.title}</h1>
				<p class="project-hero__location">{project.location}</p>
			</div>
		</div>
	</section>

	<!-- ═══════════════════ PROJECT SPECS ═══════════════════ -->
	<section class="specs">
		<div class="container">
			<div class="specs__grid reveal">
				<div class="specs__item">
					<span class="specs__label">Auftraggeber</span>
					<span class="specs__value">{project.client}</span>
				</div>
				<div class="specs__item">
					<span class="specs__label">Fläche</span>
					<span class="specs__value">{project.area}</span>
				</div>
				<div class="specs__item">
					<span class="specs__label">Bauzeit</span>
					<span class="specs__value">{project.duration}</span>
				</div>
				<div class="specs__item">
					<span class="specs__label">Jahr</span>
					<span class="specs__value">{project.year}</span>
				</div>
				<div class="specs__item specs__item--wide">
					<span class="specs__label">Leistungen</span>
					<span class="specs__value">{project.services.join(' · ')}</span>
				</div>
			</div>
		</div>
	</section>

	<!-- ═══════════════════ CASE STUDY ═══════════════════ -->
	<section class="case-study section">
		<div class="container">
			<div class="case-study__grid">
				<div class="case-study__content">
					<article class="case-study__block reveal">
						<span class="case-study__label">Aufgabenstellung</span>
						<h2 class="case-study__heading">Die Herausforderung</h2>
						<p class="case-study__text">{project.challenge}</p>
					</article>

					<article class="case-study__block reveal">
						<span class="case-study__label">Unser Ansatz</span>
						<h2 class="case-study__heading">Die Lösung</h2>
						<p class="case-study__text">{project.solution}</p>
					</article>

					<article class="case-study__block reveal">
						<span class="case-study__label">Ergebnis</span>
						<h2 class="case-study__heading">Das Resultat</h2>
						<p class="case-study__text">{project.result}</p>
					</article>
				</div>

				<!-- Image gallery sidebar -->
				<div class="case-study__gallery">
					{project.images.map((img: string, i: number) => (
						<div class="case-study__gallery-item reveal">
							<img
								src={img}
								alt={`${project.title} — Projektfoto ${i + 1}`}
								width="800"
								height="500"
								loading="lazy"
								decoding="async"
								class="case-study__gallery-image"
							/>
						</div>
					))}
				</div>
			</div>
		</div>
	</section>

	<!-- ═══════════════════ PROJECT NAVIGATION ═══════════════════ -->
	<nav class="project-nav" aria-label="Weitere Projekte">
		<a href={`/projekte/${prevProject.slug}`} class="project-nav__link project-nav__link--prev">
			<span class="project-nav__direction">Vorheriges Projekt</span>
			<span class="project-nav__name">{prevProject.title}</span>
		</a>
		<a href={`/projekte/${nextProject.slug}`} class="project-nav__link project-nav__link--next">
			<span class="project-nav__direction">Nächstes Projekt</span>
			<span class="project-nav__name">{nextProject.title}</span>
		</a>
	</nav>

	<Footer slot="footer" />
</Layout>

<style>
	/* ═══════════════════ PROJECT HERO ═══════════════════ */
	.project-hero {
		position: relative;
		min-height: 65vh;
		min-height: 65dvh;
		display: flex;
		align-items: flex-end;
		padding-top: 80px;
		overflow: hidden;
	}

	.project-hero__bg { position: absolute; inset: 0; }
	.project-hero__bg-image { width: 100%; height: 100%; object-fit: cover; }
	.project-hero__bg-overlay { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(12,26,46,0.3) 0%, rgba(12,26,46,0.7) 60%, rgba(12,26,46,0.95) 100%); }

	.project-hero__inner {
		position: relative;
		z-index: 1;
		width: 100%;
		max-width: var(--container-wide);
		margin-inline: auto;
		padding: 0 var(--section-x) var(--space-12);
		display: flex;
		flex-direction: column;
		gap: var(--space-8);
	}

	.project-hero__back {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		font-size: var(--text-sm);
		color: rgba(255,255,255,0.5);
		font-weight: 500;
		transition: color var(--transition-fast);
	}
	.project-hero__back:hover { color: var(--color-brass-light); }

	.project-hero__category {
		display: block;
		font-size: var(--text-xs);
		font-weight: 600;
		color: var(--color-brass);
		letter-spacing: 0.15em;
		text-transform: uppercase;
		margin-bottom: var(--space-3);
	}

	.project-hero__title {
		font-family: var(--font-heading);
		font-size: clamp(2rem, 1.5rem + 3vw, 3.5rem);
		font-weight: 700;
		color: var(--color-white);
		line-height: 1.1;
	}

	.project-hero__location {
		font-size: var(--text-lg);
		color: rgba(255,255,255,0.5);
		margin-top: var(--space-2);
	}

	/* ═══════════════════ SPECS ═══════════════════ */
	.specs {
		background: var(--color-white);
		padding-block: var(--space-10);
		border-bottom: 1px solid var(--color-border);
	}

	.specs__grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: var(--space-6);
	}

	@media (min-width: 768px) {
		.specs__grid {
			grid-template-columns: repeat(4, 1fr);
		}

		.specs__item--wide {
			grid-column: 1 / -1;
		}
	}

	@media (min-width: 1024px) {
		.specs__grid {
			grid-template-columns: repeat(5, 1fr);
		}

		.specs__item--wide {
			grid-column: auto;
		}
	}

	.specs__label {
		display: block;
		font-size: var(--text-xs);
		font-weight: 600;
		color: var(--color-brass);
		letter-spacing: 0.1em;
		text-transform: uppercase;
		margin-bottom: var(--space-1);
	}

	.specs__value {
		font-size: var(--text-base);
		color: var(--color-charcoal);
		font-weight: 500;
	}

	/* ═══════════════════ CASE STUDY ═══════════════════ */
	.case-study__grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-12);
	}

	@media (min-width: 1024px) {
		.case-study__grid {
			grid-template-columns: 1.2fr 1fr;
			gap: var(--space-16);
		}
	}

	.case-study__content {
		display: flex;
		flex-direction: column;
		gap: var(--space-10);
	}

	.case-study__label {
		display: block;
		font-size: var(--text-xs);
		font-weight: 600;
		color: var(--color-brass);
		letter-spacing: 0.15em;
		text-transform: uppercase;
		margin-bottom: var(--space-2);
	}

	.case-study__heading {
		font-family: var(--font-heading);
		font-size: var(--text-2xl);
		font-weight: 700;
		color: var(--color-navy);
		margin-bottom: var(--space-4);
	}

	.case-study__text {
		font-size: var(--text-base);
		line-height: 1.8;
		color: var(--color-muted);
	}

	/* Gallery */
	.case-study__gallery {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
	}

	.case-study__gallery-item {
		border-radius: var(--radius-md);
		overflow: hidden;
	}

	.case-study__gallery-image {
		width: 100%;
		height: auto;
		aspect-ratio: 8 / 5;
		object-fit: cover;
		transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.case-study__gallery-item:hover .case-study__gallery-image {
		transform: scale(1.03);
	}

	/* ═══════════════════ PROJECT NAV ═══════════════════ */
	.project-nav {
		display: grid;
		grid-template-columns: 1fr 1fr;
		border-top: 1px solid var(--color-border);
	}

	.project-nav__link {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
		padding: var(--space-8) var(--section-x);
		transition: background var(--transition-fast);
	}

	.project-nav__link:hover {
		background: var(--color-surface);
	}

	.project-nav__link--next {
		text-align: right;
		border-left: 1px solid var(--color-border);
	}

	.project-nav__direction {
		font-size: var(--text-xs);
		font-weight: 600;
		color: var(--color-brass);
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.project-nav__name {
		font-family: var(--font-heading);
		font-size: var(--text-lg);
		font-weight: 600;
		color: var(--color-navy);
	}
</style>
