---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import projects from '../../content/projekte/data.json';
---

<Layout
	title="Projekte"
	description="Referenzprojekte des Bauingenieurbüros Andrej Knezevic. Wohnbau, Gewerbe und Sanierung — jedes Projekt ein Beweis für Präzision und Kompetenz."
>
	<Header slot="header" currentPath="/projekte" />

	<!-- ═══════════════════ PAGE HERO ═══════════════════ -->
	<section class="page-hero">
		<div class="page-hero__bg">
			<img
				src="https://images.unsplash.com/photo-1487958449943-2429e8be8625?w=1920&h=900&fit=crop&q=80"
				alt=""
				role="presentation"
				width="1920"
				height="900"
				loading="eager"
				fetchpriority="high"
				class="page-hero__bg-image"
			/>
			<div class="page-hero__bg-overlay" aria-hidden="true"></div>
		</div>
		<div class="page-hero__inner container">
			<div class="page-hero__content">
				<span class="page-hero__eyebrow reveal">
					<span class="page-hero__eyebrow-line" aria-hidden="true"></span>
					Referenzen
				</span>
				<h1 class="page-hero__title reveal">
					Projekte, die<br />
					<span class="page-hero__accent">für sich sprechen.</span>
				</h1>
				<p class="page-hero__subtitle reveal">
					Jedes Projekt erzählt eine Geschichte — von der Herausforderung
					über die Lösung bis zum Ergebnis.
				</p>
			</div>
		</div>
	</section>

	<!-- ═══════════════════ PROJECT GRID ═══════════════════ -->
	<section class="project-overview section">
		<div class="container">
			<!-- Filter -->
			<div class="filter reveal" role="tablist" aria-label="Projekte filtern">
				<button class="filter__btn is-active" data-filter="all" role="tab" aria-selected="true">Alle</button>
				<button class="filter__btn" data-filter="Neubau" role="tab" aria-selected="false">Neubau</button>
				<button class="filter__btn" data-filter="Gewerbe" role="tab" aria-selected="false">Gewerbe</button>
				<button class="filter__btn" data-filter="Sanierung" role="tab" aria-selected="false">Sanierung</button>
			</div>

			<!-- Grid -->
			<div class="project-grid">
				{projects.map((project, i) => (
					<a
						href={`/projekte/${project.slug}`}
						class:list={['project-card', 'reveal', { 'project-card--wide': i === 0 }]}
						data-category={project.category}
					>
						<div class="project-card__image-wrapper">
							<img
								src={project.heroImage}
								alt={`${project.title} — ${project.subcategory} in ${project.location}`}
								width="1200"
								height="700"
								loading={i < 2 ? 'eager' : 'lazy'}
								decoding={i < 2 ? 'auto' : 'async'}
								class="project-card__image"
							/>
							<div class="project-card__overlay">
								<span class="project-card__cta">Case Study lesen</span>
							</div>
						</div>
						<div class="project-card__info">
							<div class="project-card__meta">
								<span class="project-card__category">{project.category}</span>
								<span class="project-card__year">{project.year}</span>
							</div>
							<h2 class="project-card__title">{project.title}</h2>
							<p class="project-card__location">{project.location} · {project.area}</p>
						</div>
					</a>
				))}
			</div>
		</div>
	</section>

	<!-- ═══════════════════ CTA ═══════════════════ -->
	<section class="projekte-cta">
		<div class="container">
			<div class="projekte-cta__inner reveal">
				<h2 class="projekte-cta__title">Wird Ihr Projekt das nächste?</h2>
				<p class="projekte-cta__text">Erzählen Sie uns davon — wir zeigen Ihnen, was möglich ist.</p>
				<a href="/kontakt" class="btn btn--primary btn--lg">
					Projekt besprechen
					<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
				</a>
			</div>
		</div>
	</section>

	<Footer slot="footer" />
</Layout>

<style>
	/* Buttons */
	.btn { display: inline-flex; align-items: center; justify-content: center; gap: var(--space-2); font-family: var(--font-body); font-weight: 600; font-size: var(--text-sm); letter-spacing: 0.02em; padding: var(--space-3) var(--space-8); border-radius: var(--radius-sm); transition: background var(--transition-fast), color var(--transition-fast), transform var(--transition-fast), box-shadow var(--transition-fast); cursor: pointer; text-decoration: none; border: 1.5px solid transparent; touch-action: manipulation; }
	.btn:active { transform: scale(0.97); }
	.btn--primary { background: var(--color-brass); color: var(--color-navy); border-color: var(--color-brass); }
	.btn--primary:hover { background: var(--color-brass-dark); border-color: var(--color-brass-dark); box-shadow: 0 4px 24px rgba(var(--color-brass-rgb), 0.35); transform: translateY(-2px); }
	.btn--lg { padding: var(--space-4) var(--space-10); font-size: var(--text-base); }

	/* ═══════════════════ PAGE HERO ═══════════════════ */
	.page-hero { position: relative; min-height: 80vh; min-height: 80dvh; display: flex; align-items: flex-end; padding-top: 80px; overflow: hidden; }
	.page-hero__bg { position: absolute; inset: 0; }
	.page-hero__bg-image { width: 100%; height: 100%; object-fit: cover; transform: scale(1.1); will-change: transform; }
	.page-hero__bg-overlay { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(12,26,46,0.5) 0%, rgba(12,26,46,0.7) 40%, rgba(12,26,46,0.95) 100%); }
	.page-hero__inner { position: relative; z-index: 1; width: 100%; max-width: var(--container-wide); margin-inline: auto; padding: 0 var(--section-x) var(--space-16); }
	.page-hero__content { max-width: 640px; display: flex; flex-direction: column; gap: var(--space-5); }
	.page-hero__eyebrow { display: flex; align-items: center; gap: var(--space-4); font-family: var(--font-body); font-size: var(--text-xs); font-weight: 600; letter-spacing: 0.3em; text-transform: uppercase; color: var(--color-brass); }
	.page-hero__eyebrow-line { width: 40px; height: 1px; background: var(--color-brass); }
	.page-hero__title { font-family: var(--font-heading); font-size: clamp(2.2rem, 1.8rem + 3vw, 4rem); font-weight: 700; line-height: 1.08; color: var(--color-white); }
	.page-hero__accent { color: var(--color-brass-light); font-style: italic; }
	.page-hero__subtitle { font-size: var(--text-lg); line-height: 1.7; color: rgba(255,255,255,0.55); max-width: 460px; }

	/* ═══════════════════ FILTER ═══════════════════ */
	.filter {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		margin-bottom: var(--space-10);
	}

	.filter__btn {
		padding: var(--space-2) var(--space-6);
		font-family: var(--font-body);
		font-size: var(--text-sm);
		font-weight: 500;
		color: var(--color-muted);
		border: 1.5px solid var(--color-border);
		border-radius: var(--radius-full);
		background: transparent;
		cursor: pointer;
		transition: all var(--transition-fast);
	}

	.filter__btn:hover {
		border-color: var(--color-navy);
		color: var(--color-navy);
	}

	.filter__btn.is-active {
		background: var(--color-navy);
		color: var(--color-white);
		border-color: var(--color-navy);
	}

	/* ═══════════════════ PROJECT GRID ═══════════════════ */
	.project-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-6);
	}

	@media (min-width: 768px) {
		.project-grid {
			grid-template-columns: 1fr 1fr;
		}

		.project-card--wide {
			grid-column: 1 / -1;
		}
	}

	.project-card {
		display: block;
		border-radius: var(--radius-md);
		overflow: hidden;
		background: var(--color-white);
		box-shadow: var(--shadow-sm);
		transition: transform var(--transition-base), box-shadow var(--transition-base);
	}

	.project-card.is-hidden {
		display: none;
	}

	.project-card:hover {
		transform: translateY(-4px);
		box-shadow: var(--shadow-lg);
	}

	.project-card__image-wrapper {
		position: relative;
		overflow: hidden;
		aspect-ratio: 16 / 9;
	}

	.project-card--wide .project-card__image-wrapper {
		aspect-ratio: 21 / 9;
	}

	.project-card__image {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.8s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.project-card:hover .project-card__image {
		transform: scale(1.05);
	}

	.project-card__overlay {
		position: absolute;
		inset: 0;
		background: rgba(12, 26, 46, 0.5);
		display: flex;
		align-items: center;
		justify-content: center;
		opacity: 0;
		transition: opacity var(--transition-base);
	}

	.project-card:hover .project-card__overlay {
		opacity: 1;
	}

	.project-card__cta {
		color: var(--color-white);
		font-size: var(--text-sm);
		font-weight: 600;
		letter-spacing: 0.05em;
		padding: var(--space-3) var(--space-6);
		border: 1.5px solid var(--color-white);
		border-radius: var(--radius-sm);
	}

	.project-card__info {
		padding: var(--space-5) var(--space-6);
	}

	.project-card__meta {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: var(--space-2);
	}

	.project-card__category {
		font-size: var(--text-xs);
		font-weight: 600;
		color: var(--color-brass);
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.project-card__year {
		font-size: var(--text-xs);
		color: var(--color-muted);
	}

	.project-card__title {
		font-family: var(--font-heading);
		font-size: var(--text-xl);
		font-weight: 600;
		color: var(--color-navy);
	}

	.project-card__location {
		font-size: var(--text-sm);
		color: var(--color-muted);
		margin-top: var(--space-1);
	}

	/* ═══════════════════ CTA ═══════════════════ */
	.projekte-cta {
		background: var(--color-navy);
		padding-block: var(--space-16);
	}

	.projekte-cta__inner {
		text-align: center;
		max-width: 560px;
		margin-inline: auto;
	}

	.projekte-cta__title {
		font-family: var(--font-heading);
		font-size: var(--text-3xl);
		font-weight: 700;
		color: var(--color-white);
		margin-bottom: var(--space-3);
	}

	.projekte-cta__text {
		font-size: var(--text-lg);
		color: rgba(255,255,255,0.55);
		margin-bottom: var(--space-8);
	}
</style>

<script>
	// Parallax on hero
	const heroBg = document.querySelector('.page-hero__bg-image') as HTMLElement;
	if (heroBg && window.matchMedia('(hover: hover)').matches) {
		heroBg.style.transform = 'translateY(0px) scale(1.1)';
		window.addEventListener('scroll', () => {
			const scroll = window.scrollY;
			if (scroll < window.innerHeight) {
				heroBg.style.transform = `translateY(${scroll * 0.25}px) scale(1.1)`;
			}
		}, { passive: true });
	}

	// Filter functionality
	const filterBtns = document.querySelectorAll('.filter__btn');
	const cards = document.querySelectorAll('.project-card');

	for (const btn of filterBtns) {
		btn.addEventListener('click', () => {
			const filter = (btn as HTMLElement).dataset.filter;

			// Update active state
			for (const b of filterBtns) {
				b.classList.remove('is-active');
				b.setAttribute('aria-selected', 'false');
			}
			btn.classList.add('is-active');
			btn.setAttribute('aria-selected', 'true');

			// Filter cards
			for (const card of cards) {
				const category = (card as HTMLElement).dataset.category;
				if (filter === 'all' || category === filter) {
					card.classList.remove('is-hidden');
				} else {
					card.classList.add('is-hidden');
				}
			}
		});
	}
</script>
