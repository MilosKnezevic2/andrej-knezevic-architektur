---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
	title="Leistungen"
	description="Unsere Ingenieurleistungen: Tragwerksplanung, Einreichplanung, Ausführungsplanung, Bauleitung, Energieausweis und Sanierung. Alles aus einer Hand."
>
	<Header slot="header" currentPath="/leistungen" />

	<!-- ═══════════════════ PAGE HERO — CINEMATIC ═══════════════════ -->
	<section class="page-hero">
		<div class="page-hero__bg">
			<img
				src="https://images.unsplash.com/photo-1503387762-592deb58ef4e?w=1920&h=900&fit=crop&q=80"
				alt=""
				role="presentation"
				width="1920"
				height="900"
				loading="eager"
				fetchpriority="high"
				class="page-hero__bg-image"
			/>
			<div class="page-hero__bg-overlay" aria-hidden="true"></div>
			<div class="page-hero__grid" aria-hidden="true"></div>
		</div>
		<div class="page-hero__inner container">
			<div class="page-hero__content">
				<span class="page-hero__eyebrow reveal">
					<span class="page-hero__eyebrow-line" aria-hidden="true"></span>
					Unsere Leistungen
				</span>
				<h1 class="page-hero__title reveal">
					Sechs Disziplinen.<br />
					<span class="page-hero__accent">Ein Anspruch.</span>
				</h1>
				<p class="page-hero__subtitle reveal">
					Von der statischen Berechnung bis zur Schlüsselübergabe —
					wir begleiten Ihr Bauvorhaben durch jede Phase.
				</p>
			</div>
			<!-- Quick nav for services -->
			<nav class="page-hero__nav reveal" aria-label="Leistungen Übersicht">
				<a href="#tragwerksplanung" class="page-hero__nav-item">
					<span class="page-hero__nav-number">01</span>
					<span class="page-hero__nav-label">Tragwerk</span>
				</a>
				<a href="#einreichplanung" class="page-hero__nav-item">
					<span class="page-hero__nav-number">02</span>
					<span class="page-hero__nav-label">Einreich</span>
				</a>
				<a href="#ausfuehrungsplanung" class="page-hero__nav-item">
					<span class="page-hero__nav-number">03</span>
					<span class="page-hero__nav-label">Ausführung</span>
				</a>
				<a href="#bauleitung" class="page-hero__nav-item">
					<span class="page-hero__nav-number">04</span>
					<span class="page-hero__nav-label">Bauleitung</span>
				</a>
				<a href="#energieausweis" class="page-hero__nav-item">
					<span class="page-hero__nav-number">05</span>
					<span class="page-hero__nav-label">Energie</span>
				</a>
				<a href="#sanierung" class="page-hero__nav-item">
					<span class="page-hero__nav-number">06</span>
					<span class="page-hero__nav-label">Sanierung</span>
				</a>
			</nav>
		</div>
	</section>

	<!-- ═══════════════════ SERVICES DETAIL ═══════════════════ -->
	<section class="services-detail">
		<div class="container">

			<!-- Service 1: Tragwerksplanung -->
			<article class="service reveal" id="tragwerksplanung">
				<div class="service__content">
					<div class="service__meta">
						<span class="service__number">01</span>
						<span class="service__tag">Kernkompetenz</span>
					</div>
					<h2 class="service__title">Tragwerksplanung</h2>
					<p class="service__lead">
						Das Tragwerk ist das Rückgrat jedes Bauwerks. Wir berechnen und dimensionieren
						Konstruktionen, die nicht nur sicher, sondern auch wirtschaftlich optimiert sind.
					</p>
					<ul class="service__list" role="list">
						<li>Statische Berechnungen nach Eurocode (EC 0–8)</li>
						<li>Konstruktionsplanung in Stahlbeton, Stahl, Holz und Mauerwerk</li>
						<li>Erdbebennachweis und Fundamentierung</li>
						<li>Bewehrungsplanung und Positionspläne</li>
						<li>Prüfstatische Begleitung</li>
					</ul>
				</div>
				<div class="service__visual">
					<img
						src="https://images.unsplash.com/photo-1504307651254-35680f356dfd?w=700&h=500&fit=crop"
						alt="Tragwerksplanung — Bewehrungskonstruktion auf der Baustelle"
						width="700"
						height="500"
						loading="lazy"
						decoding="async"
						class="service__image"
					/>
				</div>
			</article>

			<!-- Service 2: Einreichplanung -->
			<article class="service service--reverse reveal" id="einreichplanung">
				<div class="service__content">
					<div class="service__meta">
						<span class="service__number">02</span>
						<span class="service__tag">Genehmigung</span>
					</div>
					<h2 class="service__title">Einreichplanung</h2>
					<p class="service__lead">
						Ohne Baugenehmigung kein Bau. Wir erstellen sämtliche Planunterlagen,
						die für eine reibungslose behördliche Genehmigung erforderlich sind.
					</p>
					<ul class="service__list" role="list">
						<li>Grundrisse, Schnitte und Ansichten nach Bauordnung</li>
						<li>Bau- und Konstruktionsbeschreibung</li>
						<li>Abstimmung mit Behörden und Sachverständigen</li>
						<li>Berücksichtigung aller landesspezifischen Vorschriften</li>
						<li>Nachreichungen und Änderungsmanagement</li>
					</ul>
				</div>
				<div class="service__visual">
					<img
						src="https://images.unsplash.com/photo-1503387762-592deb58ef4e?w=700&h=500&fit=crop"
						alt="Einreichplanung — Architektonische Baupläne"
						width="700"
						height="500"
						loading="lazy"
						decoding="async"
						class="service__image"
					/>
				</div>
			</article>

			<!-- Service 3: Ausführungsplanung -->
			<article class="service reveal" id="ausfuehrungsplanung">
				<div class="service__content">
					<div class="service__meta">
						<span class="service__number">03</span>
						<span class="service__tag">Detail</span>
					</div>
					<h2 class="service__title">Ausführungsplanung</h2>
					<p class="service__lead">
						Die Brücke zwischen Planung und Baustelle. Unsere Ausführungspläne
						sind so detailliert, dass keine Fragen offenbleiben.
					</p>
					<ul class="service__list" role="list">
						<li>Detaillierte Werkpläne im Maßstab 1:50 / 1:20 / 1:5</li>
						<li>Anschlussdetails und Knotenpunkte</li>
						<li>Massenermittlung und Leistungsverzeichnisse</li>
						<li>Koordination mit Fachplanern (HKLS, Elektro)</li>
						<li>Revisionspläne nach Fertigstellung</li>
					</ul>
				</div>
				<div class="service__visual">
					<img
						src="https://images.unsplash.com/photo-1581094794329-c8112a89af12?w=700&h=500&fit=crop"
						alt="Ausführungsplanung — Detaillierter Bauplan"
						width="700"
						height="500"
						loading="lazy"
						decoding="async"
						class="service__image"
					/>
				</div>
			</article>

			<!-- Service 4: Bauleitung -->
			<article class="service service--reverse reveal" id="bauleitung">
				<div class="service__content">
					<div class="service__meta">
						<span class="service__number">04</span>
						<span class="service__tag">Vor Ort</span>
					</div>
					<h2 class="service__title">Bauleitung & Bauaufsicht</h2>
					<p class="service__lead">
						Auf der Baustelle zählt jedes Detail. Als Ihr Bauleiter überwachen wir
						Qualität, Termine und Kosten — und lösen Probleme, bevor sie entstehen.
					</p>
					<ul class="service__list" role="list">
						<li>Örtliche Bauaufsicht und Qualitätskontrolle</li>
						<li>Koordination aller ausführenden Gewerke</li>
						<li>Termin- und Kostenverfolgung</li>
						<li>Baubesprechungen und Dokumentation</li>
						<li>Abnahmen und Mängelmanagement</li>
					</ul>
				</div>
				<div class="service__visual">
					<img
						src="https://images.unsplash.com/photo-1541888946425-d81bb19240f5?w=700&h=500&fit=crop"
						alt="Bauleitung — Ingenieur bei der Bauüberwachung"
						width="700"
						height="500"
						loading="lazy"
						decoding="async"
						class="service__image"
					/>
				</div>
			</article>

			<!-- Service 5: Energieausweis -->
			<article class="service reveal" id="energieausweis">
				<div class="service__content">
					<div class="service__meta">
						<span class="service__number">05</span>
						<span class="service__tag">Zertifikat</span>
					</div>
					<h2 class="service__title">Energieausweis</h2>
					<p class="service__lead">
						Der Energieausweis ist Pflicht — aber auch eine Chance. Wir erstellen
						normgerechte Ausweise und zeigen Potenziale zur Energieeinsparung auf.
					</p>
					<ul class="service__list" role="list">
						<li>Energieausweise für Neubau nach OIB-Richtlinie 6</li>
						<li>Energieausweise für Bestandsgebäude</li>
						<li>Heizwärmebedarf- und Endenergiebedarf-Berechnung</li>
						<li>Sanierungsempfehlungen und Maßnahmenkatalog</li>
						<li>Förderungsberatung in Zusammenarbeit mit Partnern</li>
					</ul>
				</div>
				<div class="service__visual">
					<img
						src="https://images.unsplash.com/photo-1558618666-fcd25c85f82e?w=700&h=500&fit=crop"
						alt="Energieausweis — Energetische Gebäudeanalyse"
						width="700"
						height="500"
						loading="lazy"
						decoding="async"
						class="service__image"
					/>
				</div>
			</article>

			<!-- Service 6: Sanierung & Umbau -->
			<article class="service service--reverse reveal" id="sanierung">
				<div class="service__content">
					<div class="service__meta">
						<span class="service__number">06</span>
						<span class="service__tag">Bestand</span>
					</div>
					<h2 class="service__title">Sanierung & Umbau</h2>
					<p class="service__lead">
						Bestehende Gebäude verdienen eine zweite Chance. Wir planen und begleiten
						Sanierungs- und Umbauprojekte — vom denkmalgeschützten Altbau bis zur Industrieanlage.
					</p>
					<ul class="service__list" role="list">
						<li>Bestandsaufnahme und Zustandsbewertung</li>
						<li>Tragwerksanalyse und Verstärkungsplanung</li>
						<li>Umbauplanung und Nutzungsänderungen</li>
						<li>Dachgeschossausbau und Aufstockungen</li>
						<li>Koordination mit Denkmalschutzbehörden</li>
					</ul>
				</div>
				<div class="service__visual">
					<img
						src="https://images.unsplash.com/photo-1560448204-e02f11c3d0e2?w=700&h=500&fit=crop"
						alt="Sanierung — Renoviertes historisches Gebäude"
						width="700"
						height="500"
						loading="lazy"
						decoding="async"
						class="service__image"
					/>
				</div>
			</article>

		</div>
	</section>

	<!-- ═══════════════════ CTA ═══════════════════ -->
	<section class="leistungen-cta">
		<div class="container">
			<div class="leistungen-cta__inner reveal">
				<div class="leistungen-cta__content">
					<h2 class="leistungen-cta__title">Sie wissen, was Sie brauchen?</h2>
					<p class="leistungen-cta__text">Oder auch nicht — beides ist in Ordnung. Wir beraten Sie gerne und finden die passende Lösung für Ihr Projekt.</p>
				</div>
				<div class="leistungen-cta__actions">
					<a href="/kontakt" class="btn btn--primary btn--lg">
						Jetzt anfragen
						<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
					</a>
					<a href="tel:+436677712038" class="leistungen-cta__phone">+43 667 771 2038</a>
				</div>
			</div>
		</div>
	</section>

	<Footer slot="footer" />
</Layout>

<style>
	/* ═══════════════════ BUTTONS ═══════════════════ */
	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: var(--space-2);
		font-family: var(--font-body);
		font-weight: 600;
		font-size: var(--text-sm);
		letter-spacing: 0.02em;
		padding: var(--space-3) var(--space-8);
		border-radius: var(--radius-sm);
		transition: background var(--transition-fast), color var(--transition-fast), transform var(--transition-fast), box-shadow var(--transition-fast), border-color var(--transition-fast);
		cursor: pointer;
		text-decoration: none;
		border: 1.5px solid transparent;
		touch-action: manipulation;
	}
	.btn:active { transform: scale(0.97); }
	.btn--primary { background: var(--color-brass); color: var(--color-navy); border-color: var(--color-brass); }
	.btn--primary:hover { background: var(--color-brass-dark); border-color: var(--color-brass-dark); box-shadow: 0 4px 24px rgba(var(--color-brass-rgb), 0.35); transform: translateY(-2px); }
	.btn--lg { padding: var(--space-4) var(--space-10); font-size: var(--text-base); }

	/* ═══════════════════ PAGE HERO — CINEMATIC ═══════════════════ */
	.page-hero {
		position: relative;
		min-height: 75vh;
		min-height: 75dvh;
		display: flex;
		align-items: flex-end;
		padding-top: 80px;
		overflow: hidden;
	}

	.page-hero__bg {
		position: absolute;
		inset: 0;
		z-index: 0;
	}

	.page-hero__bg-image {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 40%;
	}

	.page-hero__bg-overlay {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(180deg,
				rgba(12, 26, 46, 0.5) 0%,
				rgba(12, 26, 46, 0.65) 40%,
				rgba(12, 26, 46, 0.95) 100%
			);
	}

	.page-hero__grid {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(rgba(var(--color-brass-rgb), 0.03) 1px, transparent 1px),
			linear-gradient(90deg, rgba(var(--color-brass-rgb), 0.03) 1px, transparent 1px);
		background-size: 60px 60px;
	}

	.page-hero__inner {
		position: relative;
		z-index: 1;
		width: 100%;
		max-width: var(--container-wide);
		margin-inline: auto;
		padding: 0 var(--section-x) var(--space-12);
		display: flex;
		flex-direction: column;
		gap: var(--space-10);
	}

	@media (min-width: 1024px) {
		.page-hero__inner {
			flex-direction: row;
			justify-content: space-between;
			align-items: flex-end;
			padding-bottom: var(--space-16);
		}
	}

	.page-hero__content {
		display: flex;
		flex-direction: column;
		gap: var(--space-5);
	}

	.page-hero__eyebrow {
		display: flex;
		align-items: center;
		gap: var(--space-4);
		font-family: var(--font-body);
		font-size: var(--text-xs);
		font-weight: 600;
		letter-spacing: 0.3em;
		text-transform: uppercase;
		color: var(--color-brass);
	}

	.page-hero__eyebrow-line {
		width: 40px;
		height: 1px;
		background: var(--color-brass);
	}

	.page-hero__title {
		font-family: var(--font-heading);
		font-size: clamp(2.2rem, 1.8rem + 3vw, 4rem);
		font-weight: 700;
		line-height: 1.08;
		color: var(--color-white);
		letter-spacing: -0.01em;
	}

	.page-hero__accent {
		color: var(--color-brass-light);
		font-style: italic;
	}

	.page-hero__subtitle {
		font-size: var(--text-lg);
		line-height: 1.7;
		color: rgba(255, 255, 255, 0.55);
		max-width: 460px;
	}

	/* Quick nav for services */
	.page-hero__nav {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--space-3);
	}

	@media (min-width: 768px) {
		.page-hero__nav {
			grid-template-columns: repeat(6, 1fr);
			gap: var(--space-2);
		}
	}

	@media (min-width: 1024px) {
		.page-hero__nav {
			grid-template-columns: repeat(3, 1fr);
			gap: var(--space-2);
			max-width: 280px;
		}
	}

	.page-hero__nav-item {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-1);
		padding: var(--space-3) var(--space-2);
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: var(--radius-sm);
		transition: border-color var(--transition-fast), background var(--transition-fast);
		text-align: center;
	}

	.page-hero__nav-item:hover {
		border-color: rgba(var(--color-brass-rgb), 0.4);
		background: rgba(var(--color-brass-rgb), 0.08);
	}

	.page-hero__nav-number {
		font-family: var(--font-heading);
		font-size: var(--text-xs);
		font-weight: 700;
		color: var(--color-brass);
	}

	.page-hero__nav-label {
		font-size: 0.65rem;
		color: rgba(255, 255, 255, 0.5);
		letter-spacing: 0.05em;
		text-transform: uppercase;
		font-weight: 500;
	}

	/* ═══════════════════ SERVICES DETAIL ═══════════════════ */
	.services-detail {
		padding-block: var(--section-y);
	}

	.service {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-10);
		padding-block: var(--space-12);
		border-bottom: 1px solid var(--color-border);
	}

	.service:first-child {
		padding-top: 0;
	}

	.service:last-child {
		border-bottom: none;
	}

	@media (min-width: 1024px) {
		.service {
			grid-template-columns: 1fr 1fr;
			gap: var(--space-16);
			align-items: center;
		}

		.service--reverse {
			direction: rtl;
		}

		.service--reverse > * {
			direction: ltr;
		}
	}

	.service__meta {
		display: flex;
		align-items: center;
		gap: var(--space-4);
		margin-bottom: var(--space-4);
	}

	.service__number {
		font-family: var(--font-heading);
		font-size: var(--text-sm);
		font-weight: 700;
		color: var(--color-brass);
	}

	.service__tag {
		font-size: var(--text-xs);
		font-weight: 600;
		color: var(--color-muted);
		letter-spacing: 0.1em;
		text-transform: uppercase;
		padding: var(--space-1) var(--space-3);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-full);
	}

	.service__title {
		font-family: var(--font-heading);
		font-size: var(--text-3xl);
		font-weight: 700;
		color: var(--color-navy);
		margin-bottom: var(--space-4);
	}

	.service__lead {
		font-size: var(--text-base);
		line-height: 1.7;
		color: var(--color-muted);
		margin-bottom: var(--space-6);
	}

	.service__list {
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
	}

	.service__list li {
		position: relative;
		padding-left: var(--space-6);
		font-size: var(--text-base);
		color: var(--color-charcoal);
		line-height: 1.6;
	}

	.service__list li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.6em;
		width: 8px;
		height: 2px;
		background: var(--color-brass);
		border-radius: 1px;
	}

	/* Visual */
	.service__visual {
		border-radius: var(--radius-md);
		overflow: hidden;
	}

	.service__image {
		width: 100%;
		height: 100%;
		object-fit: cover;
		aspect-ratio: 7 / 5;
		transition: transform 0.8s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.service:hover .service__image {
		transform: scale(1.03);
	}

	/* ═══════════════════ CTA ═══════════════════ */
	.leistungen-cta {
		background: var(--color-navy);
		padding-block: var(--space-16);
	}

	.leistungen-cta__inner {
		display: flex;
		flex-direction: column;
		gap: var(--space-8);
		align-items: flex-start;
	}

	@media (min-width: 768px) {
		.leistungen-cta__inner {
			flex-direction: row;
			justify-content: space-between;
			align-items: center;
		}
	}

	.leistungen-cta__title {
		font-family: var(--font-heading);
		font-size: var(--text-2xl);
		font-weight: 700;
		color: var(--color-white);
		margin-bottom: var(--space-2);
	}

	.leistungen-cta__text {
		font-size: var(--text-base);
		color: rgba(255, 255, 255, 0.5);
		line-height: 1.6;
		max-width: 480px;
	}

	.leistungen-cta__actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-6);
		flex-shrink: 0;
	}

	.leistungen-cta__phone {
		font-size: var(--text-base);
		font-weight: 500;
		color: rgba(255, 255, 255, 0.5);
		transition: color var(--transition-fast);
	}

	.leistungen-cta__phone:hover {
		color: var(--color-brass-light);
	}
